APP_NAME=Seasonly
APP_ENV=local
APP_DEBUG=true
APP_FORCE_HTTPS=false
APP_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
TRUST_PROXY_LOCATION_HEADERS=false

API_HOST=0.0.0.0
API_PORT=8001

POSTGRES_USER=seasonly
POSTGRES_PASSWORD=seasonly_dev_password
POSTGRES_DB=seasonly
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://seasonly:seasonly_dev_password@db:5432/seasonly

AUTH_SECRET_KEY=change-this-before-real-use
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Required in production for password-reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Recipe API key
RECIPES_API_KEY=00000
RECIPES_BASE_URL=https://www.themealdb.com/api/json/v2/
RECIPES_REQUEST_TIMEOUT_SECONDS=20
RECIPES_REQUEST_RETRIES=2

# Recommendation ranking: seasonal_tfidf_v1 or emergency rollback seasonal_only_v1
RECOMMENDATION_RANKING_MODE=seasonal_tfidf_v1
